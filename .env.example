# ============================================================================
# smart-doc-parser 环境配置 —— 唯一事实来源
# ----------------------------------------------------------------------------
# 本地裸机开发、Docker 本地部署、线上部署全部使用这一份配置，
# 由 docker-compose 的 env_file、后端的 pydantic-settings、前端的 Vite(envDir)
# 三方共同读取。改这里就够了，不要另建 frontend/.env。
#
# 使用方式：cp .env.example .env   （.env 已被 .gitignore 忽略，不会进版本库）
#
# 唯一一处「本地 vs 容器」的差异：POSTGRES_HOST。
#   - 裸机跑后端时用 localhost（默认值即可）
#   - docker-compose 会给 backend 服务注入 POSTGRES_HOST=db，
#     因为容器里的 localhost 指向容器自身，不是数据库容器
# ============================================================================

# ---------------------------- 应用 ----------------------------
APP_NAME=smart-doc-parser
# development | production。production 下会启用更严格的启动校验（见下方 AUTH 段）
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true 输出 JSON 结构化日志（生产/采集），false 输出带颜色的可读日志（本地开发）
LOG_JSON=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 进程内任务调度器与并发信号量是 per-process 的，>1 会让 MAX_CONCURRENT_TASKS 失效。
# 需要扩容 API 层时，应先把任务执行拆到独立 worker（见 docs/architecture.md）。
BACKEND_WORKERS=1
# 前端对外端口（nginx 监听端口）
FRONTEND_PORT=80
# 逗号分隔。生产务必改成具体域名，不要用 *
CORS_ORIGINS=*

# ---------------------------- 数据库 ----------------------------
# docker-compose 会把 backend 服务的这一项覆盖为 db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docparser
POSTGRES_PASSWORD=docparser_dev_pwd
POSTGRES_DB=smart_doc_parser
# 跑 pytest 时使用的独立库，避免污染开发数据
POSTGRES_TEST_DB=smart_doc_parser_test

# ---------------------------- 文件上传 ----------------------------
# 容器内使用 /app/data/uploads（由 compose 注入）；裸机默认用仓库下的 data/uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md

# ---------------------------- 鉴权 ----------------------------
# false = 完全开放（仅用于本地演示与公网作品集展示）
# true  = 所有 /api/v1 业务接口要求请求头 X-API-Key
# 注意：设为 true 时 API_KEYS 不能为空，否则服务启动即失败（fail-fast，避免"以为开了鉴权其实没开"）
AUTH_ENABLED=false
# 逗号分隔的多个 key，便于轮换。生成示例：openssl rand -hex 24
API_KEYS=

# ---------------------------- DeepSeek 大模型 ----------------------------
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 本 key 可用：deepseek-flash（推荐，快且便宜）、deepseek-v4-pro（更贵，抽取任务无收益）
# 换模型只改这一行，不用动代码
DEEPSEEK_MODEL=deepseek-flash
# true = 流式输出，前端可看到模型逐字生成的内容，进度条按字符数实时推进
LLM_STREAMING=true
# deepseek-flash 是推理模型，思考 token 会计入 completion_tokens 并占用这个预算，
# 给小了会因思考耗尽而返回空内容。而且是**不确定的**：实测同一 prompt 连跑 5 次，
# 有 1 次产生了 119 个思考 token（那次输出 token 与成本都翻倍）。
# 8192 对常规文档足够；代码里检测到 finish_reason=length 会自动翻倍重试一次。
LLM_MAX_TOKENS=8192
# 抽取任务建议保持 0（结果稳定、可复现）
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# 超长文档的输入上限（字符数）。超出部分按头尾保留截断，并在结果中标记 truncated。
# 1M 上下文下可调很大，但延迟和成本会同步上升。
MAX_INPUT_CHARS=100000

# ---------------------------- 任务调度 ----------------------------
# 同时执行的抽取任务数上限。调大会加剧对 DeepSeek 的并发压力。
MAX_CONCURRENT_TASKS=3
# 单个任务的总超时（秒），含排队后的解析+抽取+校验全过程
TASK_TIMEOUT_SECONDS=300

# ---------------------------- SSE 实时进度 ----------------------------
# 服务端轮询数据库状态并推送的间隔（秒）。1 秒足够"实时"，同时天然兼容多 worker 与断线重连。
SSE_POLL_INTERVAL_SECONDS=1
# 心跳间隔（秒）。防止中间代理因连接空闲而断开。
SSE_HEARTBEAT_SECONDS=15

# ---------------------------- 前端 ----------------------------
# 前端调用后端的基地址。默认相对路径，因此：
#   Docker 部署 → nginx 把 /api/ 反代到 backend 容器
#   本地开发   → Vite dev server 把 /api/ 代理到 localhost:8000
# 两种形态行为完全一致，这是「本地与线上统一」的关键。
# 只有 VITE_ 前缀的变量会被 Vite 注入前端产物，因此上面的密钥不会泄漏到浏览器。
VITE_API_BASE_URL=/api/v1
