# ============================================================================
# 生产环境覆盖层
# ----------------------------------------------------------------------------
# 这份文件**只写与 .env 基线不同的键**，其余全部继承基线。
# 这样两个环境的差异用一条 diff 就能看完，也不会出现"同一个键改了两处
# 其中一处"的漂移。
#
# 使用方式：
#     cp .env.production.example .env.production
#     vim .env.production          # 把下面每一项都换成真实值
#     make up-prod                 # 等价于 docker compose --env-file .env
#                                  #        --env-file .env.production up -d --build
#
# ⚠️ 前置条件：完整的那份 .env 也必须存在（生产服务器上从 .env.example 复制）。
#    两份文件是叠加关系，缺了基线所有未覆盖的键都会退回代码内置默认值。
#
# ⚠️ .env.production 含真实密钥，已被 .gitignore 忽略，**不要提交**。
#
# ⚠️ 下面每一项都是必改项。后端在生产模式下会做启动预检，
#    任何一项没改到位都会**拒绝启动**并列出问题，不会带着开发配置上线。
# ============================================================================

# ---------------------------- 环境标识 ----------------------------
# 这一个键决定了加载哪个覆盖文件，因此**必须**在这里设置。
# 后端要在解析 .env 之前就知道该读哪个文件（否则是鸡生蛋），
# 所以它是通过 compose 插值注入到容器进程环境里的，而不是被"读"出来的。
APP_ENV=production

# ---------------------------- 日志 ----------------------------
# 生产用 JSON：一行一个对象，便于采集与检索。
# 开发环境的彩色可读日志在采集系统里毫无用处。
LOG_JSON=true
# 生产建议 WARNING 起步，减少噪音；排查问题时临时降到 INFO 再重启
LOG_LEVEL=INFO

# ---------------------------- 数据库 ----------------------------
# 【必改】基线里这个值是公开写在 .env.example 里的，等于没有密码。
# 生成：openssl rand -base64 24
POSTGRES_PASSWORD=【改成强密码，不要用这一行】

# ---------------------------- 鉴权 ----------------------------
# 【必改】公网部署必须开启，否则任何人都能上传文件并消耗你的大模型额度。
AUTH_ENABLED=true
# 【必改】逗号分隔，支持多个 key 以便无缝轮换。
# 生成：openssl rand -hex 24
# 轮换做法：先加上新 key（两个并存）→ 客户端切换 → 再删掉旧 key，全程不中断。
API_KEYS=【openssl rand -hex 24】

# ---------------------------- CORS ----------------------------
# 【必改】收敛为具体域名。留 * 等于允许任意站点带着用户凭据调你的接口。
# 多个用逗号分隔。注意要带协议头。
CORS_ORIGINS=https://你的域名

# ---------------------------- DeepSeek ----------------------------
# 【必改】基线里是占位值。生产环境如果还是占位值，抽取会在第一个任务上失败。
# 建议同时在 DeepSeek 控制台为该 key 设置消费上限，
# 这样即使密钥泄漏，损失也是有界的。
DEEPSEEK_API_KEY=【真实密钥】

# ============================================================================
# 以下是可选项，按需覆盖。不写就继承基线。
# ============================================================================

# 后端端口默认不对外暴露更安全——生产环境走 nginx 反代即可。
# 需要直接访问 Swagger (/docs) 时再打开，用完记得关。
# BACKEND_PORT=8000

# 并发调大前先确认 DeepSeek 账户的限流档位，否则会大量触发 429 反而更慢。
# MAX_CONCURRENT_TASKS=3
